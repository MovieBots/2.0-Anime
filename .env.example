BOT_TOKEN=PASTE_BOTFATHER_TOKEN
ADMIN_IDS=123456789
DB_PATH=animebot.db
# Source channel numeric ID, e.g. -1001234567890; bot must be an administrator there
SOURCE_CHANNEL_ID=-1001234567890
# Optional force-subscribe channels (comma-separated @usernames or IDs)
FSUB_CHANNELS=@YourChannel
# Invite/public links in same order as FSUB_CHANNELS
FSUB_LINKS=https://t.me/YourChannel
# Optional Gemini API key for thumbnail-based anime title guesses; AI can be wrong
GEMINI_API_KEY=
